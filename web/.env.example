# Nuxt Environment Variables Example
# Copy this file to .env and adjust values for your local environment.

# Base URL of the Laravel API (Laravel Sail default)
# Nuxt 3 reads NUXT_PUBLIC_* variables for runtimeConfig.public.*
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# URL of this Nuxt frontend application
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Default locale for the storefront
NUXT_PUBLIC_DEFAULT_LANGUAGE=en

# Default currency code for the storefront
NUXT_PUBLIC_DEFAULT_CURRENCY=USD

# ---------------------------------------------------------------------------
# Vite / legacy alias (for tooling that reads VITE_* variables directly)
# These mirror the NUXT_PUBLIC_* values above.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
VITE_APP_URL=http://localhost:3000
